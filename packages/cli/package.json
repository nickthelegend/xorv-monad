{
  "name": "@xorv/cli",
  "version": "0.2.0",
  "description": "Rent out your idle Claude / Codex / Grok / Qwen / Kimi / Hunyuan capacity and get paid per job in USDC over x402 on Monad.",
  "license": "MIT",
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "homepage": "https://github.com/nickthelegend/xorv-monad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/xorv-monad.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/nickthelegend/xorv-monad/issues",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "xorv": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "x402",
    "monad",
    "evm",
    "usdc",
    "erc-8004",
    "ai",
    "claude-code",
    "codex",
    "grok",
    "qwen",
    "kimi",
    "hunyuan",
    "micropayments",
    "cli",
    "agent-marketplace"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-executable.mjs dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@x402/core": "~2.27.0",
    "@x402/evm": "~2.27.0",
    "@x402/fetch": "~2.27.0",
    "@xorv/protocol": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "viem": "^2.56.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
