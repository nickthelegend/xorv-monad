{
  "name": "@xorv/mcp",
  "version": "0.1.0",
  "description": "MCP server for Xorv — lets any agent buy AI capacity from the network and pay for it over x402 on Monad.",
  "license": "MIT",
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "homepage": "https://github.com/nickthelegend/xorv-monad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/xorv-monad.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/nickthelegend/xorv-monad/issues",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "xorv-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "ausd",
    "monad",
    "x402",
    "usdc",
    "ai-agents",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xorv/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@x402/core": "~2.21.0",
    "@x402/evm": "~2.21.0",
    "@x402/fetch": "~2.21.0",
    "viem": "^2.40.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
