# A hosted Xorv provider node: `xorv start` with its config written from the
# environment (packages/cli/scripts/hosted-node.mjs). It only dials out to the broker, so
# it exposes no port. Railway selects it with RAILWAY_DOCKERFILE_PATH=Dockerfile.provider.
ARG NODE_IMAGE=node:22-slim

FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH COREPACK_ENABLE_DOWNLOAD_PROMPT=0
COPY package.json ./
RUN corepack enable && corepack install
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/cli/package.json packages/cli/
RUN pnpm install --frozen-lockfile --filter @xorv/cli...
COPY tsconfig.base.json ./
COPY packages/protocol packages/protocol
COPY packages/cli packages/cli
RUN pnpm --filter @xorv/protocol build && pnpm --filter @xorv/cli build \
 && pnpm install --frozen-lockfile --prod --filter @xorv/cli... --config.confirmModulesPurge=false

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production XORV_HOME=/data/xorv
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/protocol/package.json packages/protocol/
COPY --from=build /app/packages/protocol/dist packages/protocol/dist
COPY --from=build /app/packages/protocol/node_modules packages/protocol/node_modules
COPY --from=build /app/packages/cli/package.json packages/cli/
COPY --from=build /app/packages/cli/dist packages/cli/dist
COPY --from=build /app/packages/cli/node_modules packages/cli/node_modules
COPY packages/cli/scripts/hosted-node.mjs packages/cli/scripts/hosted-node.mjs
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["node", "packages/cli/scripts/hosted-node.mjs"]
