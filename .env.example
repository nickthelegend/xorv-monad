# ---------------------------------------------------------------------------
# Xorv — copy to .env and fill in. NEVER commit .env.
#
# Who needs what:
#   operator  ETH for gas — its facilitator relays every payment and writes the
#             audit log. The only account that ever spends ETH.
#   buyer     USDG (or USDC) to spend. No ETH: it signs, it never broadcasts.
#   provider  Nothing. It only receives.
# ---------------------------------------------------------------------------

# --- Network ----------------------------------------------------------------
# CAIP-2, as x402 expects:
#   eip155:421614  Arbitrum Sepolia (default)
#   eip155:46630   Robinhood Chain Testnet
#   eip155:42161   Arbitrum One
XORV_NETWORK=eip155:421614
# Optional. Overrides the network's public RPC with your own endpoint.
XORV_RPC_URL=

# --- Stablecoin (optional) --------------------------------------------------
# Every network has a stablecoin list, default first: USDG then USDC on
# Arbitrum Sepolia, USDG on Robinhood Chain Testnet. A 402 offers all of them,
# and buyers pay with whichever they hold. This picks the default: a symbol
# (USDG, USDC) or a token address.
#
# An address the table doesn't know is added as a custom token. It must
# implement EIP-3009, and its EIP-712 domain must be given explicitly — it is
# never read from the chain (USDG has no version() to read):
#   XORV_STABLECOIN_NAME / XORV_STABLECOIN_VERSION / XORV_STABLECOIN_SYMBOL
XORV_STABLECOIN=

# --- Broker operator / facilitator ------------------------------------------
# This account relays every buyer's signed authorization and pays the gas in
# ETH, so a job poster needs nothing but the stablecoin they are spending.
# Keep it funded with Arbitrum Sepolia ETH.
#
# The address is derived from the key; if you set both they must agree.
XORV_OPERATOR_ADDRESS=
XORV_OPERATOR_KEY=0x...              # 32 bytes of hex

# --- Contracts --------------------------------------------------------------
# The XorvLog audit trail: provider registrations, liveness and settled
# receipts, as indexed events. Deploy with `pnpm deploy:log`, then paste the
# address here. Leave blank to run without an audit trail.
XORV_LOG_ADDRESS=
# Block the contract was deployed at, so the log index starts there instead of
# walking back from the head.
XORV_LOG_FROM_BLOCK=
# eth_getLogs window size in blocks (default 10000). Arbitrum makes ~4 blocks a
# second, so widen it if your RPC allows larger ranges.
XORV_LOG_WINDOW_BLOCKS=
# Job escrow and the provider registry — being built now; placeholders.
XORV_ESCROW_ADDRESS=
XORV_REGISTRY_ADDRESS=

# --- Broker HTTP ------------------------------------------------------------
XORV_BROKER_PORT=8402
XORV_BROKER_URL=http://localhost:8402
# Comma-separated origins allowed to call the broker from a browser.
XORV_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Protocol fee in basis points taken from each job (0 = 100% to the provider).
XORV_FEE_BPS=0

# --- Demo accounts ----------------------------------------------------------
# The buyer for scripts and for the app's no-wallet fallback. It needs USDG or
# USDC and no ETH: it signs authorizations and never broadcasts.
XORV_DEMO_PAYER_ADDRESS=
XORV_DEMO_PAYER_KEY=
# The provider that receives job payments. Needs nothing — it only receives.
XORV_DEMO_PROVIDER_ADDRESS=
XORV_DEMO_PROVIDER_KEY=

# --- Frontends --------------------------------------------------------------
NEXT_PUBLIC_XORV_BROKER_URL=http://localhost:8402
NEXT_PUBLIC_XORV_NETWORK=eip155:421614
# Landing page: the XorvLog address to link, once deployed.
NEXT_PUBLIC_XORV_LOG_ADDRESS=

# --- MongoDB (optional) -----------------------------------------------------
# When set, Mongo is the restore source on boot and SQLite is the write
# guarantee: every job is written to disk synchronously and mirrored to Mongo in
# the background, so an outage can never fail a job that was already paid for.
XORV_MONGO_URI=
XORV_MONGO_DB=xorv

# --- Privy (job board, optional) --------------------------------------------
# With an app id the job board signs people in with Privy and gives them an
# embedded wallet on Arbitrum Sepolia / Robinhood Chain Testnet. Without one it
# uses the injected wallet (MetaMask, Rabby, …), and a visitor with no wallet
# can still pay from the demo account. A public client id, not a secret — put
# it in apps/app/.env.local.
NEXT_PUBLIC_PRIVY_APP_ID=
