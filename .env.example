# ---------------------------------------------------------------------------
# Xorv — copy to .env and fill in. NEVER commit .env.
# Grab a funded testnet account in ~60s at https://portal.hedera.com (Testnet).
# ---------------------------------------------------------------------------

# --- Hedera network ---------------------------------------------------------
# "hedera:testnet" or "hedera:mainnet" (CAIP-2, as x402 expects).
XORV_NETWORK=hedera:testnet

# --- Broker operator / facilitator fee payer --------------------------------
# This account pays the HBAR gas for EVERY settlement, so job posters only ever
# need the stablecoin they're paying with — never gas. Keep it funded.
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=0x...            # ECDSA hex, or DER-encoded ED25519

# --- HCS topics (created by `pnpm setup:hedera`, then pasted back here) ------
# Append-only audit trails. Registry = provider registrations, heartbeat =
# liveness+capacity, receipts = one message per settled job.
XORV_TOPIC_REGISTRY=
XORV_TOPIC_HEARTBEAT=
XORV_TOPIC_RECEIPTS=

# --- Broker HTTP ------------------------------------------------------------
XORV_BROKER_PORT=8402
XORV_BROKER_URL=http://localhost:8402
# Comma-separated origins allowed to call the broker from a browser.
XORV_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://xorv-app.vercel.app,https://xorv.vercel.app

# Protocol fee in basis points taken from each job (0 = 100% to the provider).
XORV_FEE_BPS=0

# --- Demo payer (scripts/demo only; a normal user signs in the browser) -----
XORV_DEMO_PAYER_ID=
XORV_DEMO_PAYER_KEY=

# --- Frontends --------------------------------------------------------------
NEXT_PUBLIC_XORV_BROKER_URL=http://localhost:8402
NEXT_PUBLIC_XORV_NETWORK=hedera:testnet

# --- MongoDB (optional) -----------------------------------------------------
# When set, Mongo is the restore source on boot and SQLite is the write
# guarantee: every job is written to disk synchronously and mirrored to Mongo in
# the background, so an outage can never fail a job that was already paid for.
XORV_MONGO_URI=
XORV_MONGO_DB=xorv

# --- Stablecoin --------------------------------------------------------------
# HTS token the network prices in. Defaults to Circle USDC for the network
# (testnet 0.0.429274 / mainnet 0.0.456858). Override to point at a different
# issuer or a test token.
XORV_STABLECOIN=
