# ---------------------------------------------------------------------------
# Xorv on Monad — copy to .env and fill in. NEVER commit .env.
#
# Nothing below is required to *start* the broker: with no keys it matches
# and dispatches jobs, takes payments through the hosted x402 facilitator and
# serves the ledger read-only. Keys add capabilities. `pnpm --filter
# @xorv/broker setup` reports what you have and prints what's missing.
# ---------------------------------------------------------------------------

# --- Network ----------------------------------------------------------------
# CAIP-2, as x402 puts it on the wire: eip155:10143 (Monad testnet, default)
# or eip155:143 (Monad mainnet). Anything else — a leftover hedera:testnet —
# fails at boot.
XORV_NETWORK=eip155:10143
# Optional private RPC. The public one (https://testnet-rpc.monad.xyz) caps
# eth_getLogs at 100 blocks and rate-limits at 25–50 rps.
XORV_RPC_URL=
# Optional explorer override (default https://testnet.monadscan.com; the
# MonadVision equivalent is https://testnet.monadvision.com).
XORV_EXPLORER_URL=

# --- Broker keys (raw secp256k1 hex, 0x optional) ---------------------------
# Hedera ED25519/DER keys cannot be reused on Monad; make new EVM keys with
# `pnpm --filter @xorv/broker setup --new-keys` (or `cast wallet new`).
#
# The broker's own EOA: XorvLedger writes (registrations, sampled heartbeats,
# batched receipts), rating relays and (phase 3) verifier feedback. Needs MON
# (https://faucet.monad.xyz) — keep it above ~10 MON, Monad's per-account
# reserve for in-flight gas. Unset = read-only.
XORV_OPERATOR_KEY=
# The EOA that submits buyers' EIP-3009 USDC authorizations and pays their
# MON gas when the facilitator is self-hosted. Defaults to the operator key;
# a separate key is recommended so settlements never queue behind ledger writes.
XORV_FACILITATOR_KEY=

# --- x402 facilitator ---------------------------------------------------------
# self   = in-process, signs with XORV_FACILITATOR_KEY (payments 503 without one)
# hosted = Monad's hosted facilitator, https://x402-facilitator.molandak.org
# <url>  = any other x402 v2 facilitator that supports this network
# Unset  = self when a key is configured, hosted otherwise (announced at boot).
XORV_FACILITATOR=

# --- XorvLedger (packages/contracts) ----------------------------------------
# Deploy with `XORV_BROKER_ADDRESS=<operator address> pnpm --filter
# @xorv/contracts deploy:testnet`; it prints both of these. Unset = no
# on-chain receipts (the broker still works).
XORV_LEDGER_ADDRESS=
# The deploy block: the floor for RPC log scans of the ledger.
XORV_LEDGER_FROM_BLOCK=
# Publish one provider heartbeat in this many (0 = never). Every write pays
# for its full gas limit on Monad, so liveness is sampled, not streamed.
XORV_HEARTBEAT_PUBLISH_EVERY=20
# Receipts are batched into one recordJobs call: sent after this many ms, or
# as soon as XORV_RECEIPT_BATCH_MAX are waiting (~41k gas each in a batch of
# 20 vs ~104k alone).
XORV_RECEIPT_BATCH_MS=4000
XORV_RECEIPT_BATCH_MAX=20

# Used by packages/contracts only (deploy / verify).
XORV_DEPLOYER_KEY=
XORV_BROKER_ADDRESS=
MONADSCAN_API_KEY=

# --- Broker HTTP --------------------------------------------------------------
XORV_BROKER_PORT=8402
# The broker's public base URL. It is baked into on-chain strings — ERC-8004
# agent URIs (/agents/<id>.json) and rating feedback URIs
# (/feedback/<job>.json) — so in any real deployment it must be the https URL
# the internet reaches, not localhost. Falls back to XORV_BROKER_URL.
XORV_PUBLIC_URL=http://localhost:8402
XORV_BROKER_URL=http://localhost:8402
# The web app, for the "web" service in agent registration files.
XORV_APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the broker from a browser.
XORV_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://xorv-app.vercel.app,https://xorv.vercel.app
# Behind a reverse proxy, set to 1 so rate limiting sees real client IPs.
XORV_TRUST_PROXY=0
# Protocol fee in basis points (display only today: payments go straight to
# the provider, so a fee would need a splitter contract).
XORV_FEE_BPS=0
# SQLite file for jobs and lifetime earnings ("off" disables persistence).
# Defaults to <repo>/data/xorv-monad.db — deliberately not the Hedera-era xorv.db.
XORV_DB=

# --- Envio indexer (services/indexer) ----------------------------------------
# Hasura GraphQL endpoint of the HyperIndex deployment. When set, the broker's
# /api/ledger, /api/receipts and /api/leaderboard read it first and fall back
# to RPC scans when it is down.
XORV_INDEXER_URL=

# --- AI roles (phase 3; optional, off by default) ---------------------------
# Hunyuan screens prompts before a provider sees them, Qwen routes jobs that
# didn't name an adapter, Kimi verifies results and writes ERC-8004 feedback.
# Each fails open: a role that is down never blocks a quote or a result.
# Values: XORV_ROUTER=qwen|off, XORV_SCREENER=hunyuan|off, XORV_VERIFIER=kimi|off.
XORV_ROUTER=off
XORV_SCREENER=off
XORV_VERIFIER=off
# Keys for the sponsor models (also used by the provider adapters): Qwen 3.8
# Max via Alibaba Model Studio (intl), Kimi K3 via Moonshot, Hunyuan hy4 via
# Tencent TokenHub. The XORV_QWEN_* / XORV_KIMI_* / XORV_HUNYUAN_* _API_KEY,
# _BASE_URL and _MODEL variables override these and the default endpoints/models.
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
TOKENHUB_API_KEY=

# --- Demo parties (scripts only; a real buyer signs in the browser) ---------
# `pnpm --filter @xorv/broker usdc` checks their balances. The buyer needs
# USDC only (https://faucet.circle.com, pick Monad Testnet) — no MON.
XORV_DEMO_PAYER_KEY=
XORV_DEMO_PROVIDER_ADDRESS=

# --- Frontends (apps/app, apps/landing) --------------------------------------
NEXT_PUBLIC_XORV_BROKER_URL=http://localhost:8402
NEXT_PUBLIC_XORV_NETWORK=eip155:10143
# Privy app id (dashboard.privy.io) — embedded wallets that pay x402 and sign
# ratings from the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
# The same indexer as XORV_INDEXER_URL, as the browser reaches it.
NEXT_PUBLIC_XORV_INDEXER_URL=

# --- MongoDB (optional) -------------------------------------------------------
# When set, Mongo is the restore source on boot and SQLite is the write
# guarantee: every job is written to disk synchronously and mirrored to Mongo
# in the background, so an outage can never fail a job that was already paid
# for. With docker compose: XORV_MONGO_URI=mongodb://mongo:27017 and
# `docker compose --profile mongo up`.
XORV_MONGO_URI=
XORV_MONGO_DB=xorv_monad

# --- Stablecoin override (rarely needed) --------------------------------------
# The ERC-20 the network prices in. Defaults to Circle USDC on Monad (testnet
# 0x534b2f3A21130d7a60830c2Df862319e593943A3, mainnet
# 0x754704Bc059F8C67012fEd69BC8A327a5aafb603), EIP-712 domain "USDC" / "2".
# An override must support EIP-3009; its EIP-712 name/version must match the
# token exactly or every signed payment is rejected.
XORV_STABLECOIN=
XORV_STABLECOIN_NAME=
XORV_STABLECOIN_VERSION=
