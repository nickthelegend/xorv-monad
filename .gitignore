.vscode/
*.swp

# tooling caches
.turbo/
.eslintcache
coverage/

# Video project — the source and the finished render are tracked; everything
# below is regenerable from SCRIPT.md / STORYBOARD.md and would only bloat the
# repo (voice wavs, a MusicGen bed, site capture, snapshot sheets).
videos/*/assets/voice/
videos/*/assets/bgm/
videos/*/capture/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/node_modules/
videos/*/.thumbnails/
videos/*/.waveform-cache/
videos/*/audio_engine_meta.json

# Hedera-specific agent skills, not part of this project
.agents/
demo/take*/
demo/out/
demo/scenes/
demo/audio/
demo/intro-hf/audio/
demo/intro-hf/.tmp/
demo/intro-hf/*.mp4
demo/intro-hf/work-*/

# Foundry build output
contracts/cache/
contracts/out/
contracts/broadcast/*/31337/
.env.local-stack

# forge run logs. Local and forked runs write here under real chain ids (a
# fork of Monad testnet is 10143), so committing them records addresses
# that do not exist on that chain. deployments/<network>.json is the record.
contracts/broadcast/

# demo video: raw screencast frames and renders are large; the edit sources are tracked
videos/raw/take*/
videos/raw/*.mp4
videos/raw/*.log
videos/xorv-demo/renders/
videos/xorv-demo/snapshots/
videos/xorv-demo/.thumbnails/
videos/xorv-demo/assets/footage/
deployments/hosting.env

# Rewritten by every local-stack run
deployments/anvil.json

# Playwright output
apps/app/test-results/
apps/app/playwright-report/
