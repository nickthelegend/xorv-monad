{
  "name": "xorv",
  "version": "0.2.0",
  "private": true,
  "description": "Xorv — a decentralized AI capacity network on Monad. Rent out your idle Claude/Codex/Qwen/Kimi capacity, get paid per job in USDC over x402, with ERC-8004 identity and payment-backed reputation.",
  "license": "MIT",
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "homepage": "https://github.com/nickthelegend/xorv-monad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/xorv-monad.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./services/** build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=./packages/** --filter=./services/** --filter=xorv-app --filter=xorv-landing test",
    "e2e": "pnpm --filter @xorv/e2e e2e",
    "broker": "pnpm --filter @xorv/broker dev",
    "broker:start": "pnpm --filter @xorv/broker start",
    "app": "pnpm --filter xorv-app dev",
    "landing": "pnpm --filter xorv-landing dev",
    "cli": "pnpm --filter @xorv/cli dev",
    "mcp": "pnpm --filter @xorv/mcp dev",
    "setup:monad": "pnpm --filter @xorv/broker run setup",
    "deploy:ledger": "pnpm --filter @xorv/contracts deploy:testnet",
    "verify:ledger": "pnpm --filter @xorv/contracts verify:testnet",
    "privy:setup": "pnpm --filter @xorv/mcp privy:setup",
    "usdc": "pnpm --filter @xorv/broker usdc"
  },
  "keywords": [
    "x402",
    "monad",
    "usdc",
    "erc-8004",
    "ai-agents",
    "micropayments",
    "claude-code",
    "privy",
    "envio",
    "metamask",
    "marketplace",
    "agentic-payments"
  ]
}
