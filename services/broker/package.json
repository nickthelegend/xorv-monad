{
  "name": "@xorv/broker",
  "version": "0.1.0",
  "private": true,
  "description": "Xorv broker \u2014 provider registry, job matching, x402 settlement and the Hedera audit trail.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "tsx src/scripts/setup.ts",
    "demo": "tsx src/scripts/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "usdc": "tsx src/scripts/usdc.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "@hono/node-server": "^1.14.0",
    "@x402/core": "~2.20.0",
    "@x402/fetch": "~2.20.0",
    "@x402/hedera": "~2.20.0",
    "@x402/hono": "~2.20.0",
    "@xorv/protocol": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "ws": "^8.18.0",
    "mongodb": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
