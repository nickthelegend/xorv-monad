{
  "name": "@xorv/broker",
  "version": "0.2.0",
  "private": true,
  "description": "Xorv broker — provider registry, job matching, x402 settlement on Monad and the XorvLedger audit trail.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "setup": "tsx src/scripts/setup.ts",
    "nansen:probe": "tsx src/scripts/nansen-probe.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "usdc": "tsx src/scripts/usdc.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@x402/core": "~2.27.0",
    "@x402/evm": "~2.27.0",
    "@x402/extensions": "~2.27.0",
    "@x402/hono": "~2.27.0",
    "@xorv/protocol": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "mongodb": "^6.13.0",
    "viem": "^2.56.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "@x402/fetch": "~2.27.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
