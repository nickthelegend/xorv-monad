# Copy to .env for local runs (`pnpm dev`). Envio Cloud: set the same names in the
# indexer's environment settings (only ENVIO_-prefixed variables are forwarded there).

# HyperSync API token, required for local/self-hosted runs since Nov 2025.
# Create one at https://envio.dev/app/api-tokens. Envio Cloud does not need it.
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# XorvLedger deployment (packages/contracts deploy output). Leave the start block at or
# before the deploy block so the constructor's BrokerSet event is indexed.
ENVIO_XORV_LEDGER_ADDRESS=0x0000000000000000000000000000000000000000
ENVIO_XORV_LEDGER_START_BLOCK=0

# Optional: extra addresses whose "xorv-verified" feedback counts as the Xorv verifier's
# (comma separated). The ledger's active broker (the broker's XORV_OPERATOR_KEY address)
# always counts; set this when the verifier signs with its own key, or when the start block
# is after the ledger's deploy block so the constructor's BrokerSet is never indexed.
# ENVIO_XORV_VERIFIER_ADDRESSES=0x...

# Optional: skip ERC-8004 history before this block (default 0 = every agent on the chain).
# ENVIO_ERC8004_START_BLOCK=0

# Optional: fallback RPC (HyperSync is primary). Public Monad RPC caps eth_getLogs at 100 blocks.
# ENVIO_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Local runs: plain logs instead of the terminal UI.
# ENVIO_TUI=false
